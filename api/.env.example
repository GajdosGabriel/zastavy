APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=sk
APP_FALLBACK_LOCALE=sk
APP_FAKER_LOCALE=sk_SK

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3 úložisko používateľských súborov (obrázky produktov, prílohy objednávok).
# FILESYSTEM_DISK=s3 prepne ukladanie na S3 (dev aj prod), AWS_ROOT oddelí
# prostredia v spoločnom buckete (dev/, prod/) — bez neho by si prostredia
# navzájom prepisovali objekty.
# MEDIA_PUBLIC_READ=true nastav len ak bucket (alebo CloudFront) dovoľuje
# anonymné čítanie — vtedy sa generujú priame cacheovateľné URL. Inak sa URL
# obrázkov podpisujú na MEDIA_SIGNED_TTL minút.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=
AWS_ROOT=dev
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# MEDIA_DISK=      # prázdne = použije sa FILESYSTEM_DISK
MEDIA_PUBLIC_READ=false
MEDIA_SIGNED_TTL=60

VITE_APP_NAME="${APP_NAME}"
