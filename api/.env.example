APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=sk
APP_FALLBACK_LOCALE=sk
APP_FAKER_LOCALE=sk_SK

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Chyby z laravel.log e-mailom (logs:report-errors); prázdne = používatelia s rolou super-admin
LOG_REPORT_EMAIL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zastavy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Account – e-maily zákazníkom k objednávkam idú zo schránky obchod@ v Accounte,
# odpovede zákazníkov sa vrátia do konverzácie objednávky (config/account.php).
# Token potrebuje messages:write a messages:read, webhook /api/webhooks/account
# udalosti message.*. Bez ACCOUNT_MESSAGING=true sa posiela ako doteraz.
ACCOUNT_URL=http://account.local
ACCOUNT_TOKEN=
ACCOUNT_WEBHOOK_SECRET=
# ACCOUNT_MESSAGING=false
# ACCOUNT_ALLOW_REMOTE_WRITES=false
# Kampane (emailing) v Accounte – token navyše mailing:write, webhook mailing.*.
# Postup prechodu je v docs/EMAILING.md.
# ACCOUNT_MAILING=false
# ACCOUNT_PUBLIC_URL=https://account.example.sk
# Objednávky z e-mailu (docs/EMAIL_ORDER_IMPORT.md) – webhook message.unassigned, OPENAI_API_KEY.
# EMAIL_ORDERS=false
# EMAIL_ORDERS_AUTO_CREATE=false
# EMAIL_ORDERS_SHIPPING_METHOD_ID=
# EMAIL_ORDERS_PAYMENT_METHOD_ID=

# S3 úložisko používateľských súborov (obrázky produktov, prílohy objednávok).
# FILESYSTEM_DISK=s3 prepne ukladanie na S3 (dev aj prod), AWS_ROOT oddelí
# prostredia v spoločnom buckete (dev/, prod/) — bez neho by si prostredia
# navzájom prepisovali objekty.
# MEDIA_PUBLIC_READ=true nastav len ak bucket (alebo CloudFront) dovoľuje
# anonymné čítanie — vtedy sa generujú priame cacheovateľné URL. Inak sa URL
# obrázkov podpisujú na MEDIA_SIGNED_TTL minút.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=
AWS_ROOT=dev
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# MEDIA_DISK=      # prázdne = použije sa FILESYSTEM_DISK
MEDIA_PUBLIC_READ=false
MEDIA_SIGNED_TTL=60

VITE_APP_NAME="${APP_NAME}"

# Post-kontrola údajov zákazníkov (config/customer_review.php).
# Bez kľúča beží kontrola ďalej — len bez AI vrstvy; pravidlá a obchodný
# register fungujú aj tak a stoja za väčšinu nálezov.
OPENAI_API_KEY=
CUSTOMER_REVIEW_ENABLED=true
CUSTOMER_REVIEW_AI=true
CUSTOMER_REVIEW_REGISTRY=true
CUSTOMER_REVIEW_BATCH=10
CUSTOMER_REVIEW_DELAY_MINUTES=15
CUSTOMER_REVIEW_MODEL=gpt-6-luna
# Komu chodí súhrn. Prázdne = všetkým s rolou super-admin/admin.
CUSTOMER_REVIEW_NOTIFY=

# Prevádzkové kontroly; vyžadujú trvalú cache spoločnú pre scheduler a worker.
OPS_MONITOR_ENABLED=false
OPS_QUEUE_MAX_SIZE=100
OPS_HEARTBEAT_MAX_AGE=900
OPS_FAILED_JOB_WINDOW_HOURS=24

# Registrácia nových používateľov z webu (zatiaľ vypnutá)
REGISTRATION_ENABLED=false

# Po koľkých dňoch sa maže obsah e-mailov v histórii objednávky (0 = nemazať)
ORDER_EMAIL_BODY_DAYS=730

# Po koľkých dňoch sa mažú upozornenia v zvončeku (prečítané / neprečítané)
ALERTS_READ_DAYS=30
ALERTS_UNREAD_DAYS=90

# Bankové spojenie pre platbu prevodom (ďakovná stránka, detail objednávky)
SHOP_BANK_IBAN=
SHOP_BANK_SWIFT=
SHOP_BANK_HOLDER="Gajdoš Gabriel - Reprezent"
