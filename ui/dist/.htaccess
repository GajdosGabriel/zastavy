<IfModule mod_rewrite.c>
    RewriteEngine On
    # API povoľuje origin https://zastavy-vlajky.sk. Zjednoť hostiteľa
    # ešte pred obsluhou súborov, inak sa na www nenačíta katalóg (CORS).
    RewriteCond %{HTTP_HOST} ^www\.zastavy-vlajky\.sk(?::[0-9]+)?$ [NC]
    RewriteRule ^ https://zastavy-vlajky.sk%{REQUEST_URI} [R=301,L,NE]

    RewriteBase /

    # Ak je to existujúci súbor alebo adresár, obsluž ho priamo
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Chýbajúci hashovaný súbor (starý build) musí skončiť 404, nie index.html
    # s typom text/html — inak prehliadač hlási chybu MIME namiesto 404.
    RewriteRule ^assets/ - [R=404,L]

    # Všetko ostatné presmeruj na index.html (Vue Router)
    RewriteRule ^ index.html [L]
</IfModule>

# index.html odkazuje na hashované chunky aktuálneho buildu, preto sa nesmie
# držať v cache — inak prehliadač pýta chunky, ktoré už na serveri nie sú.
<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
